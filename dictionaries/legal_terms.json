  "correction_rules": {
    "obvious_typo": {
      "enabled": true,
      "description": "명백한 오타만 자동 수정 (사전 정확도: 99% 이상)"
    },
    "context_aware": {
      "enabled": false,
      "description": "문맥 분석 기반 수정 (False positive 위험으로 기본 비활성)",
      "note": "필요 시 Claude 프롬프트 통해 수정"
    },
    "partial_match": {
      "enabled": true,
      "description": "부분 일치 감지 (예: '계약서' → '계약' 추출 후 [의심] 태그)"
    }
  },

  "validation_settings": {
    "confidence_threshold": 0.95,
    "report_suspicious_terms": true,
    "report_unknown_legal_terms": true
  }
}
